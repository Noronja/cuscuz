# Server configuration
PORT=3000

# OpenAI API Key (GPT-4o)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Realtime Database credentials (optional)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Drive API configuration (optional)
GOOGLE_DRIVE_API_KEY=AIzaSyA6aoGd1Yxj0Yn9JjzAABwQGOTkj7xEAVQ
GOOGLE_DRIVE_FOLDER_ID=1pVd7V_pfyM4Vw20yfw45jBmNFqtKTHK7?hl=pt-br

# Hardworq — Banco de questões oficial (extensivo.hardworkmedicina.api.br)
# ID da turma usado na rota /banco/questoes/{id_turma}
HARDWORQ_ID_TURMA=1273
# Cookie de sessão do Hardworq logado (F12 → Application → Cookies → session-id=...).
# A sessão expira em algumas horas: quando a API responder auth:false, copie o cookie de novo.
HARDWORQ_COOKIE=session-id=177559
# Sincronização automática em segundo plano (1 = ativa) e intervalo em horas
HARDWORQ_AUTO_SYNC=0
HARDWORQ_SYNC_INTERVAL_H=6
# Limite de questões no banco local quando o auto-sync está ativo
HARDWORQ_MAX_BANK=400
# Bases da API (padrões oficiais — só altere se mudarem)
HARDWORQ_API_BASE=https://extensivo.hardworkmedicina.api.br
HARDWORQ_HWQ_BASE=https://hardworq.hardworkmedicina.api.br
